# Copy to .env for local runs. In Azure, set these as Container App secrets /
# Key Vault references — never commit real values.

JIRA_BASE_URL=https://yoursite.atlassian.net
JIRA_EMAIL=mwp-support-agent@yourcompany.com
JIRA_API_TOKEN=
AGENT_ACCOUNT_ID=            # the service account's Jira accountId
COMMENT_VISIBILITY=jsm_internal   # jsm_internal (Jira Service Management) | role:Developers | none

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

WEBHOOK_SECRET=              # long random string, also set in the Jira Automation header

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=mwp-support@yourcompany.com

ASSETS_WORKSPACE_ID=          # Jira Assets workspace id (shown by assets-discover)

AGENT_MAX_AUTONOMY=0         # 0 shadow · 1 assist · 2 route · 3 fix · 4 resolve
AGENT_DRY_RUN=false
LOG_LEVEL=INFO
